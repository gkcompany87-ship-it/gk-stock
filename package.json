{
  "name": "as-tino-stock",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter @as-tino/shared build && pnpm --filter @as-tino/database build && pnpm --filter @as-tino/ui build && turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm test:native && pnpm --filter @as-tino/shared build && pnpm --filter @as-tino/shared test && pnpm --filter @as-tino/api test:unit && pnpm --filter @as-tino/web test:unit",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @as-tino/database prisma:generate",
    "db:migrate": "pnpm --filter @as-tino/database prisma:migrate",
    "db:seed": "pnpm db:generate && pnpm --filter @as-tino/shared build && pnpm db:seed:base",
    "db:validate": "pnpm --filter @as-tino/database prisma:validate",
    "setup:env": "node scripts/init-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:deploy": "pnpm --filter @as-tino/database prisma:deploy",
    "db:status": "pnpm --filter @as-tino/database prisma:status",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/offline-tests.mjs",
    "quality": "node scripts/quality-gates.mjs",
    "db:seed:base": "pnpm --filter @as-tino/database db:seed",
    "db:bootstrap": "pnpm db:generate && pnpm --filter @as-tino/shared build && pnpm db:seed:base",
    "test:e2e:prepare": "node scripts/prepare-e2e.mjs",
    "format:check": "prettier --check .",
    "test:pdf": "pnpm test:offline && node scripts/render-template-smoke.mjs && node scripts/render-pdf-smoke.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "db:native": "node scripts/setup-native-db.mjs",
    "mail:native": "node scripts/native-mail.mjs",
    "doctor:native": "node scripts/doctor.mjs --native",
    "test:native": "node --experimental-strip-types --test scripts/native-support.test.mjs",
    "client:configure": "node scripts/configure-client.mjs",
    "production:purge-demo": "pnpm db:generate && pnpm --filter @as-tino/database exec tsx prisma/purge-demo.ts",
    "production:check": "node scripts/production-preflight.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dev:tunnel:cleanup": "node scripts/cleanup-dev-tunnels.mjs",
    "admin:rotate-password": "pnpm db:generate && pnpm --filter @as-tino/database build && node scripts/rotate-admin-password.mjs",
    "production:security-check": "node scripts/production-security-check.mjs",
    "production:verify": "node scripts/production-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "@playwright/test": "^1.59.0",
    "@types/node": "^25.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.0",
    "turbo": "2.10.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "argon2": "catalog:"
  }
}
